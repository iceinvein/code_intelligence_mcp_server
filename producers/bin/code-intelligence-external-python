#!/bin/sh
set -eu

name=$(basename "$0")

if [ "${1:-}" != "index" ]; then
  echo "usage: $name index --output <normalized-json>" >&2
  exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
parent_dir=$(dirname "$script_dir")
if [ "$(basename "$script_dir")" = "bin" ] && [ "$(basename "$parent_dir")" = "producers" ]; then
  producer_root="$parent_dir"
else
  producer_root="$script_dir/producers"
fi
exec python3 "$producer_root/python/index.py" "$@"
